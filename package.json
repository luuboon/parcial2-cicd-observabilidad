{
  "name": "parcial2-cicd-observabilidad",
  "version": "1.0.0",
  "description": "Proyecto Parcial 2 GPDS (UTEQ): login, registro y CRUD de usuarios con CI/CD (GitHub Actions -> AWS EC2), pruebas Jest + Playwright y observabilidad con OpenTelemetry + OpenObserve",
  "main": "src/server.js",
  "scripts": {
    "start": "node --require ./src/telemetry.js src/server.js",
    "test:back": "jest --runInBand",
    "test:e2e": "playwright test",
    "test": "npm run test:back && npm run test:e2e"
  },
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/backend/**/*.test.js"
    ]
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
